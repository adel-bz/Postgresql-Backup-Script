# Copy this file to /etc/postgresql-backup/.env on the Docker host.
# Keep the server copy root-owned and mode 0600. Never commit the server copy.

S3_BUCKET=example-postgres-backups
AWS_REGION=us-east-1
# Optional: use these only if this host does not use an IAM role or AWS profile.
# Set them in the private /etc/postgresql-backup/.env file, never in this template.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# The session token is required only for temporary credentials.
CONTAINER_NAME=postgres_db
DATABASE_NAME=example_db
LOCK_FILE=/run/postgresql-backup.lock
BACKUP_TMPDIR=/var/tmp
NICE_LEVEL=10

# Optional Discord status notifications. Leave disabled unless configured.
DISCORD_ALERT_ENABLED=false
# DISCORD_WEBHOOK_URL=
