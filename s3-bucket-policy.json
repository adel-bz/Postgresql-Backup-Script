{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "IPAllow",
            "Effect": "Allow",
            "Principal": {
                "AWS": "arn:aws:iam::123456789012:user/postgres-backup-user"
            },
            "Action": [
                "s3:PutObject",
                "s3:GetObject"
            ],
            "Resource": "arn:aws:s3:::example-postgres-backups/*",
            "Condition": {
                "IpAddress": {
                    "aws:SourceIp": "IP_ADDRESS/32"
                }
            }
        }
    ]
}
